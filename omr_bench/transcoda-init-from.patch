+def _load_model_weights(model_wrapper, checkpoint_path: str) -> None:
+    """Copy a checkpoint's model weights into a freshly built trainer module."""
+    checkpoint = torch.load(checkpoint_path, map_location="cpu", weights_only=False)
+    compile_prefix = "_compiled_forward_model._orig_mod."
+    state_dict = {
+        key.replace(compile_prefix, ""): value
+        for key, value in checkpoint["state_dict"].items()
+        if key.startswith("model.")
+    }
+    missing, unexpected = model_wrapper.load_state_dict(state_dict, strict=False)
+    missing = [key for key in missing if key.startswith("model.")]
+    # Any model weight left unmatched means the architecture differs from the checkpoint.
+    if missing or unexpected:
+        raise RuntimeError(
+            f"Checkpoint {checkpoint_path} does not match the model: "
+            f"missing {missing[:5]}, unexpected {unexpected[:5]}"
+        )
+    console.print(f"[green]Loaded {len(state_dict):,} weight tensors from {escape(checkpoint_path)}[/green]")
+
