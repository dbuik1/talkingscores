{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(./staticfiles/**)",
      "Read(./media/**)",
      "Read(./tmp/**)",
      "Read(./**/__pycache__/**)",
      "Read(./venv/**)",
      "Read(./.talkingscore-env/**)",
      "Read(./.talkingscore2-env/**)",
      "Read(./venv_talkingscores/**)",
      "Read(./talkingscoresapp/static/bootstrap-3.3.2-dist/**)",
      "Read(./requirements.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-writes-only.sh",
            "statusMessage": "Checking writer is a subagent..."
          }
        ]
      }
    ]
  }
}
